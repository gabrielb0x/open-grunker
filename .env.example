# Open Grunker — configuration. Copy to .env and edit; every value has a default.

# ── Network ────────────────────────────────────────────────────────────────
# Ports 8080 and 8081 are deliberately avoided: they are in use on this host.
HOST=127.0.0.1
PORT=7420
PUBLIC_URL=https://grunker.g0x.dev
TRUST_PROXY=true
# Set true only if this site really is proxied through Cloudflare (orange
# cloud). It decides whether CF-Connecting-IP is a fact or a client's claim.
CF_PROXY=false
CORS_ORIGINS=https://grunker.g0x.dev,http://localhost:7420,http://127.0.0.1:7420

# ── Storage ────────────────────────────────────────────────────────────────
DB_PATH=data/open-grunker.db
# Left unset, the client comes from client/dist once `npm run build` has made
# one, and from client/ — the unbundled sources — until then. Set it to pin
# either: `CLIENT_DIR=client` is the no-bundler loop, no rebuild between edits.
#CLIENT_DIR=client/dist
# Set false when nginx serves the static client (saves a little work per request).
SERVE_STATIC=true

# ── Profile pictures ───────────────────────────────────────────────────────
# One file per account, served from /avatars/<file>. The client squares the
# picture, scales it to 256x256 and re-encodes it before uploading, so a normal
# avatar lands around 20 KB; these are the ceilings the server enforces on what
# actually arrives, whatever the client claims.
AVATARS_ENABLED=true
AVATAR_DIR=data/avatars
AVATAR_MAX_BYTES=196608
AVATAR_MAX_DIM=512
# The filename carries a content hash, so a new picture is a new URL and this
# can safely be a year.
AVATAR_CACHE_SEC=31536000
# A clan's picture uses the same ceilings and the same machinery, in its own
# directory, served from /avatars/clans/<file> — a sub-path of the account
# prefix so that nginx, which proxies all of /avatars/, needs to know nothing.
CLAN_AVATAR_DIR=data/clans

# ── Creators ───────────────────────────────────────────────────────────────
#
# Creator status is the one thing in this game a human decides. Players apply
# under the CREATOR tab, somebody reads the application in the admin panel, and
# an approval grants the perk that discipline earns — an anthem over the kill
# cam, a queue for commissioned finishes, a director's cut of the cam, or the
# developer instruments.
#
# CREATORS_ENABLED=false closes the whole thing: the tab, the routes and the
# queue. Anything already approved keeps working; nothing new is taken.
CREATORS_ENABLED=true
# The level an account has to reach before it may apply at all.
CREATORS_MIN_LEVEL=5
# Require a confirmed email address as well. Only has an effect where email
# verification is switched on above — a gate with nothing behind it is not one.
CREATORS_NEED_EMAIL=true
#
# Player anthems: ten seconds of a music creator's own work, played over the
# kill cam of everyone they kill.
#
# Loudness is not something the uploader decides. The server measures every
# upload over its loudest 400 ms and rewrites the samples to a fixed level
# before storing them, so a brickwalled file comes out quieter than it went in
# and a quiet one comes out louder. This ceiling is on the *stored* file, which
# is mono 16-bit PCM at 32 kHz — ten seconds of that is 640 KB.
ANTHEM_DIR=data/anthems
ANTHEM_MAX_BYTES=720896
# The filename carries a content hash, so a new track is a new URL. A year is
# safe, and matters more here than for a picture: this is fetched mid-match, at
# the moment somebody died.
ANTHEM_CACHE_SEC=31536000

# ── Developer mode ─────────────────────────────────────────────────────────
#
# Read-only overlays: frame time, the socket, the local player's own movement
# state, and a few render toggles. Nothing in it reads anything about another
# player that the client was not already drawing, which is why it is a level
# rather than a role — the gate is about not burying a new player in numbers.
DEV_MODE_ENABLED=true
DEV_MODE_LEVEL=10

# ── Accounts ───────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
REGISTRATION_OPEN=true
# scrypt cost; raise for stronger hashing at the price of slower logins.
SCRYPT_COST=16384

# ── Game ───────────────────────────────────────────────────────────────────
# The rooms that are always up, as "<map>:<mode>" — the *floor*, not the whole
# list. Maps: littletown, burgtown, crossfire, sandstorm, shipyard, subzero, range.
# Modes: ffa, tdm, gg (gun game), dom (domination), range (practice).
ROOMS=littletown:tdm,littletown:ffa,burgtown:ffa,crossfire:tdm,shipyard:gg,sandstorm:dom,subzero:ffa,range:range
MAX_PLAYERS_PER_ROOM=8
# Prefix for shareable match codes: FRA:7K2Q
REGION=FRA
BOTS_ENABLED=true
BOT_COUNT=4

# ── Rooms that come and go with the crowd ──────────────────────────────────
# Everything past the floor above is opened by demand and closed again when it
# empties. Turn this off and the room list is exactly ROOMS, forever.
DYNAMIC_ROOMS=true
# Never more than this many rooms in total. The ceiling is about CPU, not
# seats: every room is simulated every tick whether anybody is in it or not.
ROOMS_MAX=32
# Open another room of a mode once its free seats fall to this or below.
# Two is one duo arriving together. Clamped to one room's worth of seats.
ROOM_HEADROOM=2
# …and close a surplus room once it has been completely empty this long.
# Longer than a map rotation and longer than a reconnect, on purpose: a room
# that vanishes between two matches is a shared link that stops working.
ROOM_IDLE_SEC=120
# How often the balancer reconsiders the room list.
ROOM_CHECK_SEC=5

# ── Telemetry ──────────────────────────────────────────────────────────────
# What the admin panel's STATS tab draws. One row per series per interval,
# written by a timer — gameplay never touches the database on this path.
METRICS_ENABLED=true
METRICS_INTERVAL_SEC=300
# Samples and events older than this are pruned by the hourly maintenance pass.
METRICS_KEEP_DAYS=90

# ── Admin panel ────────────────────────────────────────────────────────────
# The panel has its own listener on ADMIN_PORT and answers only to loopback and
# private LAN addresses, never through nginx. Open it from this machine at
# http://127.0.0.1:7421/admin, or from a phone on the same wifi at
# http://<this-machine-lan-ip>:7421/admin. Set a password to enable it.
ADMIN_PASSWORD=change-me
ADMIN_ENABLED=true
# Refuse admin requests from outside this network. Leave this on.
ADMIN_LOCAL_ONLY=true
# Allow devices on the same private network (10.x, 192.168.x, 172.16-31.x).
# Set to false to accept the panel only from this machine.
ADMIN_ALLOW_LAN=true
ADMIN_HOST=0.0.0.0
ADMIN_PORT=7421
ADMIN_TOKEN_TTL_MIN=120

# ── Moderation ─────────────────────────────────────────────────────────────
# Shown on the ban screen so a banned player knows where to appeal.
BAN_APPEAL_CONTACT=appeal@grunker.g0x.dev

# ── Player reports ─────────────────────────────────────────────────────────
# Reports are filed from a match's scoreboard and read in the admin panel's
# REPORTS tab; the reporter reads the verdict back from their own account.
REPORTS_ENABLED=true
# Six ceilings, each answering a different way of abusing the button. None of
# them is a punishment: every one clears on its own, and the one that bites
# hardest — the open ceiling — is handed straight back as the queue is worked.
#
#   a fresh throwaway account is not a witness. Higher than the chat's gate on
#   purpose: a bad chat line costs one person one line, a bad report costs a
#   moderator the time of every real report it buried.
REPORTS_MIN_LEVEL=5
#   one incident at a time, not a burst
REPORTS_COOLDOWN_SEC=60
#   a bad evening cannot bury a week of real reports
REPORTS_MAX_PER_HOUR=6
#   ...and the hourly cap cannot simply be waited out all night
REPORTS_MAX_PER_DAY=15
#   reports nobody has read yet are not an allowance to spend
REPORTS_MAX_OPEN=5
#   one incident, one queue entry
REPORTS_REPEAT_COOLDOWN_SEC=600
#   crying wolf: N dismissed reports inside the window shut the button for
#   REPORTS_DISMISSED_LOCKOUT_HOURS, counted from the last dismissal. 0 = off.
REPORTS_DISMISSED_MAX=5
REPORTS_DISMISSED_WINDOW_DAYS=7
REPORTS_DISMISSED_LOCKOUT_HOURS=24
# Settled reports are pruned after this many days. 0 — the default — keeps them
# for good, which is what the admin panel's HANDLED tab is: the history of what
# was decided about a name, and the thing anybody wants when that name comes
# back. Open reports are never pruned either way.
REPORTS_KEEP_RESOLVED_DAYS=0

# ── Friends ─────────────────────────────────────────────────────────
# A friend list, who on it is online, and a button that drops you into their
# match. Each ceiling answers one way of turning that into a nuisance vector.
FRIENDS_ENABLED=true
FRIENDS_MAX=100
#   requests one account may have outstanding…
FRIEND_REQUESTS_MAX=40
#   …and how many may be waiting for one account to answer
FRIEND_REQUESTS_INBOX_MAX=60
FRIEND_REQUEST_COOLDOWN_SEC=5
#   a fresh throwaway account is not somebody's friend
FRIEND_MIN_LEVEL=2

# ── Away from keyboard ──────────────────────────────────────────────
# Counted from real input — a key held or the view moving — and never from the
# socket being alive: a page left open answers every heartbeat, and so does the
# timer an anti-AFK script is built out of. The warning lands at AFK_WARN_SEC
# and holds the automatic respawn; ignoring it until AFK_KICK_SEC hands the seat
# back and returns the player to the menu.
AFK_ENABLED=true
AFK_WARN_SEC=75
AFK_KICK_SEC=105

# ── Anti-cheat ───────────────────────────────────────────────────────
# The room refuses a packet that contradicts what the server measured whatever
# these say — shot angles are matched against the streamed view, the spread seed
# is the server's counter, the rewind comes off a round trip the server timed,
# and simulation steps are spent out of a bucket that refills in real time.
#
# What these turn on is the *scoring* of those refusals and the kick at the end
# of it. ANTICHEAT_ENABLED=false leaves a server that is still not fooled, just
# one that never drops anybody for trying; ANTICHEAT_KICK=false warns and logs
# without dropping, for an operator who would rather work the queue by hand.
# A kick files a report into the same queue the scoreboard's report button
# writes to, so nothing is ever decided without a human reading it.
ANTICHEAT_ENABLED=true
ANTICHEAT_KICK=true
ANTICHEAT_WARN_SCORE=40
ANTICHEAT_KICK_SCORE=120

# ── Clans ──────────────────────────────────────────────────────────────────
# A clan is a 2-4 character tag drawn in front of a nickname everywhere one
# appears: grey normally, gold once the developers have verified it from the
# admin panel. Clans are invite-only — the owner is the only door in.
CLANS_ENABLED=true
# What it takes to accept an invitation, and what it takes to found one.
CLAN_JOIN_LEVEL=5
CLAN_CREATE_LEVEL=15
CLAN_CREATE_COST=1000
CLAN_MAX_MEMBERS=24
# Outstanding invitations one clan may hold, and how long each one lives.
CLAN_MAX_INVITES=25
CLAN_INVITE_TTL_HOURS=72

# ── Anti-abuse ─────────────────────────────────────────────────────────────
RATE_WINDOW_MS=60000
RATE_MAX_REQUESTS=240
RATE_MAX_AUTH=12
MAX_WS_PER_IP=6

# ── Anti-bot: Cloudflare Turnstile ─────────────────────────────────────────
# Two independent widgets, one per form, each with its own key pair. The site
# key is public (the browser needs it); the secret is what actually enforces
# the check. Leave a secret empty to turn that form's check off.
TURNSTILE_ENABLED=true
TURNSTILE_SITEKEY_REGISTER=0x0000000000000000000000
TURNSTILE_SECRET_REGISTER=0x00000000000000000000000000000000000
TURNSTILE_SITEKEY_LOGIN=0x0000000000000000000000
TURNSTILE_SECRET_LOGIN=0x00000000000000000000000000000000000

# ── Email verification ─────────────────────────────────────────────────────
# EMAIL_REQUIRED    an address is mandatory at sign-up
# EMAIL_VERIFY_ENFORCE  an unverified account cannot take a seat in a match.
#                   Leave this false until a real transport below is tested,
#                   or nobody will be able to play.
EMAIL_VERIFICATION=true
EMAIL_REQUIRED=true
EMAIL_VERIFY_ENFORCE=false
EMAIL_VERIFY_TTL_HOURS=48
EMAIL_RESEND_COOLDOWN_SEC=120

# MAIL_TRANSPORT=log writes the confirmation link to the server log instead of
# sending it — what a machine with no mail credentials should do. Switch to
# 'smtp' once the settings below work. See docs/EMAIL.md for the three ways to
# get SMTP credentials for g0x.dev.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@g0x.dev
MAIL_FROM_NAME=Open Grunker
MAIL_REPLY_TO=

# Proton Bridge on this host:  SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_STARTTLS=true
# Proton Business submission:  SMTP_HOST=smtp.protonmail.ch  SMTP_PORT=587
# Any provider (Resend, Brevo): their host on 587 (STARTTLS) or 465 (SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=15000

# ── One account, one game ──────────────────────────────────────────────────
# takeover: the newest connection wins and the old one is told why (default —
#           the only policy a half-open socket cannot lock somebody out of).
# refuse:   a second connection is turned away while the first is in a match.
SINGLE_SESSION=true
SINGLE_SESSION_POLICY=takeover

# ── VPN / proxy / datacenter blocking ──────────────────────────────────────
# VPN_PROVIDER=ipapi       ip-api.com — free, no key, 45 lookups/min, HTTP only
#             =proxycheck  proxycheck.io — needs PROXYCHECK_KEY, HTTPS, better
#             =none        turn lookups off entirely
# VPN_FAIL_OPEN=true lets a player in when the lookup itself fails; an
# unreachable third party is not evidence of anything.
VPN_BLOCK=true
VPN_PROVIDER=ipapi
PROXYCHECK_KEY=
VPN_BLOCK_HOSTING=true
VPN_BLOCK_TOR=true
VPN_FAIL_OPEN=true
VPN_CACHE_HOURS=72
VPN_TIMEOUT_MS=2500
# Addresses and CIDRs that are never checked — your own, a LAN, a friend's VPS.
VPN_ALLOWLIST=

# ── Nickname ───────────────────────────────────────────────────────────────
# What a signed-in player pays to change their name. Guests never choose one.
RENAME_COST=100

# ── Logging ────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
